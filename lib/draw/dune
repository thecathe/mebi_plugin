; Plain OCaml, like lib/utils and lib/model: no rocq-runtime, so test/ links it
; without a Rocq runtime. Only unix, to run lualatex and a rasteriser as child
; processes, and lib/utils, for the directory a file goes in.
(library
 (name draw)
 (public_name rocq-mebi.draw)
 (libraries rocq-mebi.utils unix)
 (modules draw_style draw draw_dot draw_output)
 (wrapped false))

(include_subdirs no)
